 
cmake_minimum_required(VERSION 2.8.2)

project(cmnalib-download NONE)

include(ExternalProject)
ExternalProject_Add(cmnalib
    GIT_REPOSITORY @CMNALIB_REPO@
    GIT_TAG 417fbc108367a1936eb090d8915fc3301156d822
#    (pinned to v1.0.0's exact commit; was floating tag "v1.0.0")
    SOURCE_DIR "${CMAKE_BINARY_DIR}/cmnalib-src"
    BINARY_DIR "${CMAKE_BINARY_DIR}/cmnalib-build"
    CONFIGURE_COMMAND ""
    BUILD_COMMAND ""
    INSTALL_COMMAND ""
    TEST_COMMAND ""
)
